{
	"app": {
		"bundleName": "Calories.Lite.Test",
		"vendor": "calorielite",
		"versionCode": 1000000,
		"versionName": "1.0.0",
		"icon": "$media:layered_image",
		"label": "$string:app_name",
		"apiReleaseType": "Release",
		"compileSdkVersion": "26.0.0.105",
		"targetAPIVersion": 260000026,
		"minAPIVersion": 260000026,
		"compileSdkType": "HarmonyOS",
		"targetMinorAPIVersion": 0,
		"targetPatchAPIVersion": 0,
		"minMinorAPIVersion": 0,
		"minPatchAPIVersion": 0,
		"appEnvironments": [],
		"bundleType": "app",
		"buildMode": "debug",
		"debug": true
	},
	"module": {
		"name": "entry",
		"type": "entry",
		"description": "$string:module_desc",
		"mainElement": "EntryAbility",
		"deviceTypes": [
			"phone",
			"tablet"
		],
		"deliveryWithInstall": true,
		"installationFree": false,
		"pages": "$profile:main_pages",
		"metadata": [
			{
				"name": "ohos.arkui.uiMaterial",
				"value": "{\"state\": 1, \"type\": 2}"
			}
		],
		"requestPermissions": [
			{
				"name": "ohos.permission.INTERNET"
			},
			{
				"name": "ohos.permission.GET_NETWORK_INFO"
			},
			{
				"name": "ohos.permission.CAMERA",
				"reason": "$string:reason_camera",
				"usedScene": {
					"abilities": [
						"EntryAbility"
					],
					"when": "inuse"
				}
			},
			{
				"name": "ohos.permission.READ_IMAGEVIDEO",
				"reason": "$string:reason_photo",
				"usedScene": {
					"abilities": [
						"EntryAbility"
					],
					"when": "inuse"
				}
			}
		],
		"abilities": [
			{
				"name": "EntryAbility",
				"srcEntry": "./ets/entryability/EntryAbility.ets",
				"description": "$string:EntryAbility_desc",
				"icon": "$media:layered_image",
				"label": "$string:EntryAbility_label",
				"startWindowIcon": "$media:startIcon",
				"startWindowBackground": "$color:start_window_background",
				"exported": true,
				"metadata": [
					{
						"name": "ohos.arkui.uiMaterial",
						"value": "{\"state\": 1, \"type\": 2}"
					}
				],
				"skills": [
					{
						"entities": [
							"entity.system.home"
						],
						"actions": [
							"ohos.want.action.home"
						]
					}
				]
			}
		],
		"extensionAbilities": [
			{
				"name": "EntryBackupAbility",
				"srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
				"type": "backup",
				"exported": false,
				"metadata": [
					{
						"name": "ohos.extension.backup",
						"resource": "$profile:backup_config"
					}
				]
			}
		],
		"packageName": "entry",
		"virtualMachine": "ark24.0.0.0",
		"compileMode": "esmodule",
		"dependencies": []
	}
}
