{
  "name": "@ohos/tar_rs",
  "version": "2.1.2",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "name": "@ohos/tar_rs",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-gnu"
      ]
    }
  },
  "files": [
    "*.d.ts",
    "@ohos/**/*"
  ],
  "license": "MIT",
  "devDependencies": {
    "@napi-rs/cli": "^2.18.2",
    "ava": "^6.0.1"
  },
  "engines": {
    "node": ">= 10"
  },
  "ava": {
    "timeout": "3m"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "universal": "napi universal",
    "version": "napi version",
    "pack": "bash script/pack.sh"
  },
  "optionalDependencies": {
    "@ohos/tar_rs-darwin-x64": "2.1.2",
    "@ohos/tar_rs-darwin-arm64": "2.1.2",
    "@ohos/tar_rs-win32-x64-msvc": "2.1.2",
    "@ohos/tar_rs-linux-x64-gnu": "2.1.2",
    "@ohos/tar_rs-linux-arm64-gnu": "2.1.2",
    "@ohos/tar_rs-win32-x64-gnu": "2.1.2"
  }
}